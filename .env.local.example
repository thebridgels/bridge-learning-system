NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required for full account deletion (src/lib/supabase/admin.ts only).
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# Server-only, never NEXT_PUBLIC_ — never import admin.ts into a client
# component or return this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Bridge Analysis / Generation model+effort — each defaults to
# claude-sonnet-5 / medium if unset. Server-only; never exposed to the client.
BRIDGE_ANALYSIS_MODEL=claude-sonnet-5
BRIDGE_ANALYSIS_EFFORT=medium
BRIDGE_GENERATION_MODEL=claude-sonnet-5
BRIDGE_GENERATION_EFFORT=medium
