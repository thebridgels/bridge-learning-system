NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Bridge Analysis model/effort — defaults to claude-sonnet-5 / medium
# if unset. Server-only; never exposed to the client.
BRIDGE_ANALYSIS_MODEL=claude-sonnet-5
BRIDGE_ANALYSIS_EFFORT=medium
